{
  "name": "@iptv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "pnpm run build && node --env-file-if-exists=.env --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@iptv/ai-runtime": "workspace:*",
    "@iptv/auth": "workspace:*",
    "@iptv/config": "workspace:*",
    "@iptv/database": "workspace:*",
    "@iptv/domain": "workspace:*",
    "@iptv/observability": "workspace:*",
    "@iptv/secrets": "workspace:*",
    "@iptv/workflows": "workspace:*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "fastify": "^5.6.2",
    "kysely": "^0.28.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
