# Staging Outbox Worker environment — PLACEHOLDERS ONLY.
#
# Dedicated to the `outbox-worker` compose service (profile `outbox`):
#     docker compose --env-file .env.staging -f deploy/staging/docker-compose.staging.yml \
#       --profile outbox up -d outbox-worker
#
# Deliberately SEPARATE from `.env.staging`: the worker connects as
# `outbox_worker` (migration 050) and that credential must never be injected
# into the API container (which connects as `iptv_app`) or the migrate job
# (owner). `docker compose` requires every referenced env_file to exist, so
# this file ships with everything commented out — uncomment ONLY for a
# specific authorized staging run, after the legacy drain is quiesced
# (see docs/10-operations/runbooks/rls-role-split-cutover.md "Worker process
# + legacy quiescence").
#
# Secrets discipline: set the role password ONCE per environment with
#   ALTER ROLE outbox_worker PASSWORD '...';
# and keep the resulting URL below in the operator secret path. Never paste a
# real value into this file. The worker boot re-proves the server-side posture
# (current_user/session_user, pg_roles, grants) on every start.

# --- activation (all three REQUIRED to start) --------------------------------
# OUTBOX_WORKER_ENABLED=1
# OUTBOX_WORKER_ID=staging-outbox-1
# OUTBOX_WORKER_DATABASE_URL=postgresql://outbox_worker:replace-with-worker-password@postgres:5432/iptv
# OUTBOX_LEGACY_QUIESCED=1

# --- observed legacy state (REQUIRED explicit: unknown is fail-closed) -----
# Copy BOTH from GET /v1/admin/outbox/drain-state after quiescing. The API
# default is drain ENABLED, so an unset value is treated as "not proven
# disabled/empty" and refuses boot — never assume the default.
# OUTBOX_LEGACY_DRAIN_ENABLED=0
# OUTBOX_LEGACY_IN_FLIGHT=0

# --- runtime tuning (safe defaults exist; override only with cause) ---------
# OUTBOX_WORKER_BATCH_SIZE=25
# OUTBOX_WORKER_POLL_MS=1000
# OUTBOX_WORKER_LEASE_SECONDS=300
# OUTBOX_WORKER_RENEW_AFTER_MS=150000
# OUTBOX_WORKER_MAX_CONCURRENCY=4
# OUTBOX_WORKER_MIN_BACKOFF_MS=60000
# OUTBOX_WORKER_MAX_BACKOFF_MS=3600000
# OUTBOX_WORKER_SHUTDOWN_TIMEOUT_MS=15000
# OUTBOX_WORKER_MAX_RENEWS=6
