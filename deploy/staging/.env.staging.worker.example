# Staging Browser Worker environment - PLACEHOLDERS ONLY.
#
# Dedicated to the `browser-worker` compose service (profile `worker`):
#     docker compose --env-file .env.staging -f deploy/staging/docker-compose.staging.yml \
#       --profile worker run --rm browser-worker read-credit-balance
#
# Deliberately SEPARATE from `.env.staging`: worker credentials must never be
# injected into the API container. `docker compose` requires every referenced
# env_file to exist, so this file ships with everything commented out —
# uncomment ONLY what a specific authorized run needs.
#
# Secrets discipline: the worker does NOT read a secret manager and does NOT
# touch the database. A standalone authorized run receives CINEVISION_EMAIL +
# CINEVISION_PASSWORD directly (per invocation); the API normally supplies them
# when it spawns the worker. The panel URL is the non-secret
# CINEVISION_ALLOWED_ORIGIN. Real credentials are never committed here.

# --- worker target binding (authorized runs only) --------------------------
# BROWSER_WORKER_ENABLED
# BROWSER_WORKER_PROVIDER
# BROWSER_WORKER_TENANT_ID
# BROWSER_WORKER_PROVIDER_ACCOUNT_ID
# CINEVISION_ALLOWED_ORIGIN
# CINEVISION_LOGIN_PATH
# CINEVISION_EMAIL
# CINEVISION_PASSWORD

# --- runtime tuning (safe defaults exist; override only with cause) --------
# BROWSER_WORKER_HEADLESS
# BROWSER_WORKER_CHALLENGE_WAIT_SECONDS
# BROWSER_WORKER_COMMAND_TIMEOUT_MS
# BROWSER_WORKER_LAUNCH_SETTLE_MS
