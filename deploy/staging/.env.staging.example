# Staging environment — PLACEHOLDERS ONLY.
#
# Copy to `.env.staging` IN THIS DIRECTORY (gitignored, never committed):
#   Copy-Item deploy/staging/.env.staging.example deploy/staging/.env.staging
#
# `.env.staging` does two jobs, so keep that in mind when editing it:
#   1. compose interpolation + `env_file` for the containers (postgres entry,
#      api, web, opt-in worker);
#   2. the API runtime env validated by `packages/config` at boot.
#
# Because it drives interpolation too, pass it explicitly on every command:
#   docker compose --env-file .env.staging -f deploy/staging/docker-compose.staging.yml up -d
#
# Fail-closed boundary (2026-10-06, proven in a real container): this file
# carries the OWNER connection (`DATABASE_URL` + `POSTGRES_PASSWORD`) for
# interpolation and the migrate job, but the production boot guard
# (`assertNoPrivilegedDatabaseEnv`) refuses to start the API when those reach
# the API process — the compose file blanks them for the `api` service, so do
# not "fix" that by re-adding owner credentials to the API environment.
#
# Secrets discipline: this file may only contain values that are OK to read in
# a terminal (or generated locally). Provider/VPS/Cloudflare credentials live in
# the encrypted PostgreSQL store (configured through the Control Center) — never
# write them here. Never paste a real value into this example file.

# --- compose / postgres ------------------------------------------------------
# The postgres entrypoint only applies these to a FRESH volume. Changing them
# later does not reconfigure an initialized volume: adjust the roles in place,
# never recreate the volume to "apply" them.
POSTGRES_DB=iptv
POSTGRES_USER=iptv_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- database connections ----------------------------------------------------
# MIGRATION JOB (`migrate` service): schema OWNER, direct, never pooled. The
# CLI refuses to run as `iptv_app`; DDL rights live here.
DATABASE_URL=postgresql://iptv_owner:replace-with-a-long-random-password@postgres:5432/iptv
# API POOL: application role `iptv_app` (NOBYPASSRLS). REQUIRED — the
# production boot guard refuses to start the API without a valid restricted
# APP_DATABASE_URL, and there is no owner fallback. Setting it here is
# rehearsal, NOT cutover: reads on not-yet-enrolled domains fail closed until
# the RLS cutover checklist is complete.
APP_DATABASE_URL=postgresql://iptv_app:replace-with-a-long-random-password@postgres:5432/iptv

# --- api runtime -------------------------------------------------------------
# `production` tightens boot: BETTER_AUTH_SECRET must be overridden and
# PROVIDER_DISPATCH_MODE must be exactly `durable` (the durable dispatcher is
# the only certified executor for real provider writes).
NODE_ENV=production
PORT=3001
# REQUIRED: without it the Fastify logger stays disabled and the container boots
# silently.
LOG_LEVEL=info
# Session-token pepper. Generate per environment, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
# Public origins (2026-10-17): NEXT_PUBLIC_API_BASE_URL is the PUBLIC api
# hostname, NOT the loopback port — it is baked into the web bundle at build
# time (`next build`); changing it requires `build web` + recreate.
# The two API-side vars (BETTER_AUTH_URL, CORS_ALLOWED_ORIGINS) are runtime:
# recreate api is enough.
BETTER_AUTH_URL=https://staging-api.synkroo.com.br
# Explicit browser origins, comma-separated, no wildcard/path. Unset in
# production means cross-origin requests are DENIED.
CORS_ALLOWED_ORIGINS=https://staging-web.synkroo.com.br
# Build-time browser value for apps/web (inlined by `next build`, so changing
# it requires rebuilding the web image).
NEXT_PUBLIC_API_BASE_URL=https://staging-api.synkroo.com.br

# Zero-Trust tunnel for the public entrypoint (lane-owned service; see the
# "Public entrypoint (staging tunnel, opt-in)" section of the staging-deploy
# runbook). Remote-managed ingress: staging-api -> 127.0.0.1:3001 and
# staging-web -> 127.0.0.1:3000. Fill the token host-only (operator vault or
# GET /accounts/{id}/cfd_tunnel/{id}/token); never commit it.
# IPTV_STAGING_TUNNEL_TOKEN=

# Provider dispatch (production fail-fast, see packages/config):
PROVIDER_DISPATCH_MODE=durable
# FASE5-S4S5: only the single disposable account real trial dispatches may
# touch. Commented = no designation = real trial writes stay fail-closed.
# PROVIDER_TRIAL_DISPOSABLE_ACCOUNT_ID=

# Safe defaults for everything optional: no real provider/billing calls, no
# background workers. Keep the values explicit so a staging boot is auditable.
PROVIDER_OPS_ADAPTER=manual
PROVIDER_ECHO_OUTCOME=success
PROVIDER_READBACK_EFFECT=NOT_APPLIED
ASAAS_ADAPTER=echo
REFUND_APPROVAL_TTL_HOURS=168
API_SCHEDULER_ENABLED=0
API_SCHEDULER_TICK_SECONDS=60
# Legacy outbox drain gate (API-side; default enabled preserves current
# behavior). Set to 0 as the FIRST activation step before starting the
# dedicated outbox-worker, then prove zero in-flight via
# GET /v1/admin/outbox/drain-state — a stopped scheduler alone is not proof
# (see rls-role-split-cutover.md "Worker process + legacy quiescence").
# The worker itself takes NO credential from this file: its dedicated,
# gitignored env file is described by
# deploy/staging/.env.staging.outbox-worker.example (copy it next to the
# compose file, never commit it).
# The legacy in-process outbox drainer is a ROLLBACK path only: keep it at 0
# while the permanent outbox-worker owns publishing (DB runtime mode WORKER).
# LEGACY_OUTBOX_DRAIN_ENABLED=0
# Optional workers: still off on a fresh staging box. Enable one at a time and
# watch the outbox/reconciliation runbooks.
# API_SCHEDULER_ENABLED=1
# ASAAS_API_KEY=
# ASAAS_BASE_URL=

# --- messaging (Wave 2) ------------------------------------------------------
# Both are required before manual replies go out through WAHA; otherwise the
# API uses LocalEchoGateway (logs locally, safe default).
# WAHA_BASE_URL=
# WAHA_API_KEY=
# WAHA_SESSION=default
# Webhook channels authenticate per channel (`communication.tenant_channels` /
# `billing.tenant_channels`) — there is NO global webhook secret variable.

# --- secrets (AES-256-GCM in PostgreSQL, packages/secrets) -------------------
# Single 256-bit key for the API's encrypted secrets store: base64 of exactly
# 32 random bytes. Keep it OUTSIDE the database (operator custody) and back it
# up separately from the PostgreSQL dump. Absent = secret reads/writes fail
# closed. Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECRETS_ENCRYPTION_KEY=

# --- cinevision browser worker runtime (API-spawned child process) -----------
# Defaults are set in docker-compose for the api service. Override here only if
# the image layout changes. PLAYWRIGHT_BROWSERS_PATH must point at the
# Chromium installed during the image build.
# CINEVISION_WORKER_CLI=/app/apps/browser-worker/dist/cli.js
# CINEVISION_WORKER_PROFILE_BASE=/data/cinevision-profiles
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- browser worker (opt-in, `--profile worker`) ------------------------------
# Credentials for an authorized on-demand smoke run. The API normally spawns
# the worker per tenant/account and passes CINEVISION_EMAIL/PASSWORD for that
# invocation only. Keep every line below commented: the worker fails closed on
# partial config.
# BROWSER_WORKER_ENABLED=1
# BROWSER_WORKER_PROVIDER=CINEVISION
# BROWSER_WORKER_TENANT_ID=
# BROWSER_WORKER_PROVIDER_ACCOUNT_ID=
# CINEVISION_ALLOWED_ORIGIN=
# CINEVISION_LOGIN_PATH=
# CINEVISION_EMAIL=
# CINEVISION_PASSWORD=
# BROWSER_WORKER_HEADLESS=1
# BROWSER_WORKER_CHALLENGE_WAIT_SECONDS=45
# BROWSER_WORKER_COMMAND_TIMEOUT_MS=60000
# BROWSER_WORKER_LAUNCH_SETTLE_MS=3000

# --- observability (optional) ------------------------------------------------
# Unset endpoint = noop exporters (zero overhead, no network). Uncomment both
# to export OTLP; the optional SDK/exporter packages must be present.
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true

# Never in this file: VPS/Cloudflare credentials (deploy-only) and the
# CINEVISION/MK provider credentials (encrypted in PostgreSQL, configured via
# the Control Center).