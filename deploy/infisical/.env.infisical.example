# Placeholder-only template. Replace secret placeholders on the server.
# Never commit a real .env.infisical or copy its values into a report.
# DB name/user shown are fresh-install defaults; preserve the deployed values.
SITE_URL=https://infisical.synkroo.com.br
ENCRYPTION_KEY=REPLACE_ME
AUTH_SECRET=REPLACE_ME
INFISICAL_POSTGRES_DB=infisical
INFISICAL_POSTGRES_USER=infisical
# stack db-central (homologa��o); senha nova no .env da VPS
INFISICAL_POSTGRES_PASSWORD=REPLACE_ME
# DB_CONNECTION_URI host: db-hml (wired by compose; no password in this example)
# stack db-central (homologação); senha nova no .env da VPS
DB_CONNECTION_URI=postgresql://infisical:REPLACE_ME@db-hml:5432/infisical
