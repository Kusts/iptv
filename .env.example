# Local development only — never commit real secrets.
# Copy to `.env` (gitignored) and adjust locally.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Browser CORS allowlist (non-secret): comma-separated exact
# `http(s)://host[:port]` origins, no wildcard/path/query. Production must
# set the explicit public web origin(s); when unset, cross-origin is denied.
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://iptv:iptv@localhost:5432/iptv
# Session-token pepper for the API auth (packages/auth). Placeholder only:
# generate a long random value for real environments, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3001
# Wave 2 messaging (optional): when WAHA_BASE_URL + WAHA_API_KEY are set the
# API sends manual replies through WAHA; otherwise LocalEchoGateway is used
# (logs locally, returns an `echo:` provider id — safe default for dev/CI).
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# `POST /v1/webhooks/waha/:tenantKey` authenticates `X-Waha-Secret`
# per-channel-only against each channel's `webhook_secret_hash` in
# `communication.tenant_channels`; there is no global fallback variable.
# Configure each active channel hash out-of-band until a provisioning
# endpoint exists. A channel without a hash rejects with 503 before
# inbox/domain effects.
# Wave 4 provider operations (no real CINEVISION credentials exist anywhere):
# PROVIDER_OPS_ADAPTER=echo|manual (default manual). `echo` resolves
# operations deterministically in-process (success by default; override per
# call or via PROVIDER_ECHO_OUTCOME=success|failed|unknown). `manual` parks
# operations in HUMAN_REQUIRED for a provider operator to resolve.
PROVIDER_OPS_ADAPTER=manual
PROVIDER_ECHO_OUTCOME=success
# Stub readback answer for `provider.reconcile` (APPLIED|NOT_APPLIED;
# default NOT_APPLIED, the safe answer). The real CINEVISION readback
# implements the port after Wave-0 certification.
PROVIDER_READBACK_EFFECT=NOT_APPLIED
# FASE5-S4S5 controlled CREATE_TRIAL only: account id of the single
# disposable provider account real trial dispatches may execute against.
# Absent by default (no designation = real trial writes stay fail-closed,
# even with the trial capability AVAILABLE). When set, it must be the uuid
# of an ACTIVE provider account; the value is an id, never a secret.
# PROVIDER_TRIAL_DISPOSABLE_ACCOUNT_ID=

# Wave 5 billing/Asaas (no real Asaas calls without explicit configuration):
# ASAAS_ADAPTER=echo|real (default echo). echo resolves charges/refunds
# deterministically in-process (per-call outcomes via
# ASAAS_ECHO_CREATE=ok|failed|unknown, ASAAS_ECHO_RECONCILE=paid|failed|unknown,
# ASAAS_ECHO_REFUND=applied|not_applied|unknown,
# ASAAS_ECHO_REFUND_RECONCILE=applied|not_applied|unknown). The real adapter requires
# ASAAS_API_KEY + ASAAS_BASE_URL and maps transport timeouts to UNKNOWN_EFFECT
# (charge stays PROCESSING + reconcile task, NEVER an automatic create retry).
ASAAS_ADAPTER=echo
# ASAAS_API_KEY=
# ASAAS_BASE_URL=
# `POST /v1/webhooks/asaas/:tenantKey` authenticates per-channel-only:
# canonical `asaas-access-token` header (`X-Asaas-Secret` remains as a
# legacy alias, canonical takes precedence) against each channel's
# `webhook_secret_hash` in `billing.tenant_channels`; there is no global
# fallback variable. Configure each active channel hash out-of-band until
# a provisioning endpoint exists. A channel without a hash rejects with
# 503 before inbox/domain effects.
# Approved-refund decision TTL in hours before execution rejects it as stale
# (default 168 = 7 days).
REFUND_APPROVAL_TTL_HOURS=168

# W1-08 worker infrastructure (all optional; safe defaults = everything off):
# API_SCHEDULER_ENABLED=1 arms the in-process scheduler loop after bootstrap
# (default 0 = off). API_SCHEDULER_TICK_SECONDS sets the interval (5–3600,
# default 60). Local mode is explicitly NON-durable (in-memory only).
API_SCHEDULER_ENABLED=0
API_SCHEDULER_TICK_SECONDS=60
# Hatchet durable workflows (Wave-0-gated, NEVER default): set both to let
# the workflow factory construct the Hatchet adapter. Requires the optional
# `@hatchet-dev/hatchet` SDK; missing SDK/config falls back to local with a
# logged warning. Durable adoption awaits W0-04 certification.
HATCHET_API_TOKEN=
HATCHET_SERVER_URL=
# W1-12 observability (all optional; default = noop, zero overhead, no network):
# set OTEL_EXPORTER_OTLP_ENDPOINT + OTEL_SDK_DISABLED=false to export
# OTLP-http traces/metrics (requires the optional SDK/exporter packages;
# otherwise the bootstrap keeps the noop path with a warning).
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
# Langfuse AI observability (future boundary only — interface, no dep, no calls):
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# OpenCode Go through the OpenAI-compatible gateway. Put the OpenCode Go API
# key in OPENAI_API_KEY; without it the deterministic Echo gateway is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_MODEL=deepseek-v4.1-flash

# Optional integration-test database; use a disposable database only.
TEST_DATABASE_URL=

# RLS application role (cutover target; see
# docs/10-operations/runbooks/rls-role-split-cutover.md). Migrations and DDL
# keep using DATABASE_URL (owner, direct, never pooled). When set, the API
# pool prefers APP_DATABASE_URL over DATABASE_URL (fallback order:
# APP_DATABASE_URL → DATABASE_URL → TEST_DATABASE_URL); cutover = set
# APP_DATABASE_URL + restart, no code change. Point the app at
# APP_DATABASE_URL only after the cutover checklist is complete.
# Placeholder only — fill from the approved secret path, never commit real values.
APP_DATABASE_URL=

# Deployment/provider credentials do not belong in this API runtime env:
# VPS/Cloudflare credentials are deploy-only; CINEVISION/MK credentials belong
# in a scoped secret manager/isolated worker and are not consumed from env yet.
