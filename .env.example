# Local development only — never commit real secrets.
# Copy to `.env` (gitignored) and adjust locally.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://iptv:iptv@localhost:5432/iptv
# Session-token pepper for the API auth (packages/auth). Placeholder only:
# generate a long random value for real environments, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3001
# Wave 2 messaging (optional): when WAHA_BASE_URL + WAHA_API_KEY are set the
# API sends manual replies through WAHA; otherwise LocalEchoGateway is used
# (logs locally, returns an `echo:` provider id — safe default for dev/CI).
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Shared secret for `POST /v1/webhooks/waha/:tenantKey` (`X-Waha-Secret`
# header). Per-tenant secrets live in `communication.tenant_channels`; this
# global value applies to channels without their own secret hash.
WAHA_WEBHOOK_SECRET=replace-with-a-long-random-secret
